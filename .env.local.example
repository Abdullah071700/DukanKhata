# DukanKhata Environment Configuration
# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit your real .env.local or service role keys to git!

# Your Supabase Project URL (e.g., https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Publishable/Anon Key (Client-safe key used with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
